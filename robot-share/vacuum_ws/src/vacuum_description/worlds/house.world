    <!-- Sofa: base + back + 2 arms + cushions -->
    <model name="sofa">
      <static>true</static>
      <pose>-2.5 -2.8 0 0 0 1.5708</pose>
      <link name="link">
        <collision name="c_base"><geometry><box><size>2.0 0.8 0.35</size></box></geometry><pose>0 0 0.175 0 0 0</pose></collision>
        <visual name="v_base"><geometry><box><size>2.0 0.8 0.35</size></box></geometry><pose>0 0 0.175 0 0 0</pose>
