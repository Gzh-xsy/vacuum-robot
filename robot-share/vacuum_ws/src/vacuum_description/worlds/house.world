          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- ==================== LIVING ROOM ==================== -->

    <!-- Table: top + 4 legs -->
    <model name="table">
      <static>true</static>
      <pose>1.2 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="c_top"><geometry><box><size>1.2 0.8 0.05</size></box></geometry><pose>0 0 0.75 0 0 0</pose></collision>
        <visual name="v_top"><geometry><box><size>1.2 0.8 0.05</size></box></geometry><pose>0 0 0.75 0 0 0</pose>
          <material><script><name>Gazebo/Wood</name></script></material></visual>
        <collision name="c_l1"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>0.55 0.35 0.35 0 0 0</pose></collision>
        <visual name="v_l1"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>0.55 0.35 0.35 0 0 0</pose>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name="c_l2"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>-0.55 0.35 0.35 0 0 0</pose></collision>
        <visual name="v_l2"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>-0.55 0.35 0.35 0 0 0</pose>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name="c_l3"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>0.55 -0.35 0.35 0 0 0</pose></collision>
        <visual name="v_l3"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>0.55 -0.35 0.35 0 0 0</pose>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name="c_l4"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>-0.55 -0.35 0.35 0 0 0</pose></collision>
        <visual name="v_l4"><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><pose>-0.55 -0.35 0.35 0 0 0</pose>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <!-- Chair: seat + back + 4 legs (macro-like, repeated 5x via separate models) -->
