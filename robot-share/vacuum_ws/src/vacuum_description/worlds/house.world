<?xml version="1.0"?>
<sdf version="1.6">
  <world name="house">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ==================== Outer walls (9 x 9 m) ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9 0.15 2.2</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9 0.15 2.2</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.5 0 1.1 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9 0.15 2.2</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.5 0 1.1 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9 0.15 2.2</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Interior wall with door gap at y=0.5 (gap x in [-1.5, 1.5]) -->
    <model name="wall_div_west">
      <static>true</static>
      <pose>-3.0 0.5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.15 2.2</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
